# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Replace with your own MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/internai?retryWrites=true&w=majority

# JWT Secret
# Use any long random string — keep this secret!
JWT_SECRET=internai_super_secret_jwt_key_2024_change_this_in_production
JWT_EXPIRE=7d

# Gemini API Key
# Get it from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads